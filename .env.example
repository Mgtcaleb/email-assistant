# Copy to .env for local Docker testing only; never commit real values.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_USER=
SLACK_WEBHOOK_URL=
AMAZON_MARKETS=amazon.in,amazon.com
POLL_SECONDS=300
INITIAL_LOOKBACK_DAYS=30
DRY_RUN=true
OPENCLAW_GATEWAY_PORT=8080
OPENCLAW_GATEWAY_TOKEN=replace-with-a-long-random-secret
DATA_DIR=/data
OPENCLAW_STATE_DIR=/data/.openclaw
OPENCLAW_WORKSPACE_DIR=/data/workspace
